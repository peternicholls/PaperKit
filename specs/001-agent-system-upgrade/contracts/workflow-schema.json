{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "$id": "workflow-schema.json",
    "title": "Compositional Workflow Schema",
    "description": "JSON Schema for validating compositional workflow YAML definitions (formerly 'skills')",
    "type": "object",
    "required": [
        "name",
        "displayName",
        "description",
        "version",
        "type",
        "steps",
        "inputSchema",
        "outputSchema"
    ],
    "properties": {
        "name": {
            "type": "string",
            "description": "Machine identifier (kebab-case)",
            "pattern": "^[a-z][a-z0-9]*(-[a-z0-9]+)*$",
            "examples": [
                "cite-source",
                "validate-citation",
                "compile-latex"
            ]
        },
        "displayName": {
            "type": "string",
            "description": "Human-readable workflow name",
            "minLength": 1,
            "maxLength": 100,
            "examples": [
                "Cite Source",
                "Validate Citation",
                "Compile LaTeX"
            ]
        },
        "description": {
            "type": "string",
            "description": "What the workflow does",
            "minLength": 1,
            "maxLength": 500
        },
        "version": {
            "type": "string",
            "description": "Semantic version",
            "pattern": "^\\d+\\.\\d+\\.\\d+$",
            "examples": [
                "1.0.0",
                "2.1.0"
            ]
        },
        "type": {
            "type": "string",
            "description": "Workflow type",
            "enum": [
                "atomic",
                "composite",
                "conditional"
            ]
        },
        "prerequisites": {
            "type": "array",
            "description": "Required workflows or tools before execution",
            "items": {
                "type": "object",
                "required": [
                    "type",
                    "name"
                ],
                "properties": {
                    "type": {
                        "type": "string",
                        "enum": [
                            "workflow",
                            "tool"
                        ]
                    },
                    "name": {
                        "type": "string"
                    }
                }
            },
            "default": []
        },
        "steps": {
            "type": "array",
            "description": "Ordered execution steps",
            "minItems": 1,
            "items": {
                "$ref": "#/definitions/WorkflowStep"
            }
        },
        "inputSchema": {
            "type": "object",
            "description": "JSON Schema for required inputs"
        },
        "outputSchema": {
            "type": "object",
            "description": "JSON Schema for guaranteed outputs"
        },
        "timeout": {
            "type": "integer",
            "description": "Max execution time in milliseconds",
            "minimum": 1000,
            "default": 60000
        },
        "retryPolicy": {
            "type": "object",
            "description": "Retry behavior on failure",
            "properties": {
                "maxRetries": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 5,
                    "default": 2
                },
                "backoffMs": {
                    "type": "integer",
                    "minimum": 100,
                    "default": 1000
                },
                "retryableErrors": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    },
                    "default": [
                        "network_timeout",
                        "rate_limited"
                    ]
                }
            }
        },
        "metadata": {
            "type": "object",
            "description": "Additional metadata",
            "properties": {
                "author": {
                    "type": "string"
                },
                "tags": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    }
                },
                "category": {
                    "type": "string"
                }
            }
        }
    },
    "definitions": {
        "WorkflowStep": {
            "type": "object",
            "required": [
                "action",
                "agent",
                "inputs",
                "outputs"
            ],
            "properties": {
                "action": {
                    "type": "string",
                    "description": "Step identifier",
                    "pattern": "^[a-z][a-z0-9]*(-[a-z0-9]+)*$"
                },
                "agent": {
                    "type": "string",
                    "description": "Agent to execute this step"
                },
                "skill": {
                    "type": "string",
                    "description": "Optional Agent Skill to load for context"
                },
                "inputs": {
                    "type": "array",
                    "description": "Input variable names from state",
                    "items": {
                        "type": "string"
                    }
                },
                "outputs": {
                    "type": "array",
                    "description": "Output variable names to add to state",
                    "items": {
                        "type": "string"
                    }
                },
                "condition": {
                    "type": "string",
                    "description": "Conditional expression for conditional workflows"
                },
                "onError": {
                    "type": "string",
                    "description": "Error handling strategy",
                    "enum": [
                        "fail",
                        "skip",
                        "retry"
                    ],
                    "default": "fail"
                }
            }
        }
    },
    "additionalProperties": false
}